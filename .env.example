# ── Авторизация в веб-панели ───────────────────────────────
# Логин и пароль для входа в интерфейс.
# Обязательно смените значения перед запуском в проде.
AUTH_LOGIN=admin
AUTH_PASSWORD=admin

# ── Подпись JWT-токенов ────────────────────────────────────
# Секрет, которым подписываются токены сессии.
# Сгенерируйте случайную строку, например:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-random-secret-key-in-production

# ── AI-провайдеры (endpoint / модель / ключ) ───────────────
# Все значения опциональны — если не заданы, используются дефолты
# из src/ai_provider.py. Ключи провайдеров обычно приходят из
# веб-панели (per-client), но env-ключи нужны для авто-fallback:
# если основной провайдер вернул 403/таймаут/битый JSON, второй
# провайдер из списка вызывается с ключом отсюда.

# Anthropic Claude. Чтобы использовать прямой Anthropic API вместо
# прокси, укажите официальный endpoint, модель и ключ:
#   CLAUDE_URL=https://api.anthropic.com/v1/messages
#   CLAUDE_MODEL=claude-sonnet-4-5
# CLAUDE_URL=https://api.oneprovider.dev/v1/messages
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_API_KEY=
# Альтернативное стандартное имя для ключа Anthropic (тоже читается):
# ANTHROPIC_API_KEY=

# DeepSeek (OpenAI-совместимый endpoint).
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
